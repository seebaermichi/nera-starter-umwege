# Node modules
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local

# OS-specific
.DS_Store
Thumbs.db

# Testing
coverage/
.vitest/

# Builds (if you ever bundle or compile)
dist/
build/

# VSCode settings
.vscode/

# Optional cache folders
.cache/

# npm credentials — never commit
.npmrc

# Test scratch directory
.tmp/
plans/
.claude/.work-issue-active

# Internal development files (plans, Snagio workflow, specs) never belong in the repo
/.claude/
/.mcp.json
/ROADMAP*.md
/DESIGN-BRIEF.md

# Build output of a local `nera build` in this folder stays out of git. npm pack
# ignores these lines inside `files` folders: test/scaffold.test.js fails while
# a search index sits in theme/assets/, so a hand publish cannot ship one.
/public/
/.nera-cache/
/theme/assets/search-index*.json
